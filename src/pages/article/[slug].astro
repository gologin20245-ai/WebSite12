---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaButton from '../../components/common/CtaButton.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({
    params: { slug: a.data.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.seo?.title || data.title,
  description: data.seo?.description || data.excerpt,
  image: data.cover,
  author: { '@type': 'Person', name: data.author },
  datePublished: data.date,
};
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description || data.excerpt}
  ogImage={data.cover}
  lang={data.lang}
  noindex={data.noindex}
  jsonLd={jsonLd}
  trackerId={data.trackerId}
  offerUrl={data.offerUrl}
>
  <article class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
    {data.cover && (
      <img
        src={data.cover}
        alt={data.title}
        class="w-full rounded-2xl mb-8 object-cover max-h-96"
      />
    )}

    <header class="mb-8">
      {data.category && (
        <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full mb-4">
          {data.category}
        </span>
      )}
      <h1 class="text-3xl sm:text-4xl font-bold text-text leading-tight mb-4">{data.title}</h1>
      {data.excerpt && <p class="text-lg text-text-muted">{data.excerpt}</p>}

      <div class="flex items-center gap-3 mt-6">
        {data.authorAvatar && (
          <img src={data.authorAvatar} alt={data.author} class="w-10 h-10 rounded-full" />
        )}
        <div>
          {data.author && <p class="font-medium text-sm">{data.author}</p>}
          {data.date && <p class="text-xs text-text-muted">{data.date}</p>}
        </div>
      </div>
    </header>

    <div class="prose prose-lg max-w-none mb-8
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:leading-relaxed [&_p]:mb-4 [&_p]:text-text
      [&_ul]:mb-4 [&_ul]:pl-6 [&_ul]:list-disc
      [&_ol]:mb-4 [&_ol]:pl-6 [&_ol]:list-decimal
      [&_li]:mb-2
      [&_strong]:font-semibold
      [&_a]:text-primary [&_a]:underline
      [&_blockquote]:border-l-4 [&_blockquote]:border-primary [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:my-6
      [&_table]:w-full [&_table]:border-collapse [&_table]:my-6
      [&_th]:bg-gray-50 [&_th]:px-4 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:border [&_th]:border-gray-200
      [&_td]:px-4 [&_td]:py-2 [&_td]:border [&_td]:border-gray-200
    ">
      <Content />
    </div>

    <div class="bg-gradient-to-r from-blue-50 to-green-50 rounded-2xl p-8 text-center border border-gray-100">
      <h3 class="text-xl font-bold mb-3">Заинтересовались?</h3>
      <p class="text-text-muted mb-6">Узнайте больше о рекомендованном комплексе</p>
      <CtaButton text={data.ctaText} />
    </div>

    {data.tags && data.tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <span class="px-3 py-1 bg-gray-100 text-text-muted text-sm rounded-full">#{tag}</span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
