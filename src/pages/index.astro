---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const quizzes = await getCollection('quiz');
const articles = await getCollection('articles');
const comparisons = await getCollection('comparisons');
const reviews = await getCollection('reviews');
const calculators = await getCollection('calculators');
const faqs = await getCollection('faqs');
const stories = await getCollection('stories');

const sections = [
  { title: 'Quiz-воронки', items: quizzes, prefix: '/quiz/', color: 'bg-blue-500' },
  { title: 'Статьи / Longread', items: articles, prefix: '/article/', color: 'bg-purple-500' },
  { title: 'Сравнения продуктов', items: comparisons, prefix: '/comparison/', color: 'bg-green-500' },
  { title: 'Обзоры продуктов', items: reviews, prefix: '/review/', color: 'bg-orange-500' },
  { title: 'Калькуляторы / Тесты', items: calculators, prefix: '/calculator/', color: 'bg-cyan-500' },
  { title: 'FAQ-страницы', items: faqs, prefix: '/faq/', color: 'bg-yellow-500' },
  { title: 'Story-формат', items: stories, prefix: '/story/', color: 'bg-pink-500' },
];
---

<BaseLayout title="Pre-lander Factory — Dashboard" lang="ru" noindex={true}>
  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-3">Pre-lander Factory</h1>
      <p class="text-text-muted text-lg">Dashboard всех прокладок. 7 форматов, одна система.</p>
      <a href="/admin/" class="inline-block mt-4 px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition">
        Открыть CMS-админку →
      </a>
    </div>

    {sections.map((section) => (
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class:list={['w-3 h-3 rounded-full', section.color]}></span>
          <h2 class="text-xl font-bold">{section.title}</h2>
          <span class="text-text-muted text-sm">({section.items.length})</span>
        </div>

        {section.items.length > 0 ? (
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {section.items.map((item) => (
              <a
                href={section.prefix + item.data.slug}
                class="block bg-white rounded-xl border border-gray-200 p-4 hover:border-primary hover:shadow-md transition"
              >
                <h3 class="font-medium text-sm mb-1 line-clamp-2">{item.data.title}</h3>
                <p class="text-xs text-text-muted">{section.prefix}{item.data.slug}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-text-muted text-sm italic">Нет контента. Создайте через CMS или добавьте файлы в src/content/</p>
        )}
      </div>
    ))}
  </div>
</BaseLayout>
