---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const quizzes = await getCollection('quiz');
  return quizzes.map((q) => ({ params: { slug: q.data.slug }, props: { quiz: q.data } }));
}

const { quiz } = Astro.props;
---

<BaseLayout
  title={quiz.title}
  description={quiz.description}
  ogImage={quiz.ogImage}
  lang={quiz.lang}
  noindex={quiz.noindex}
  trackerId={quiz.trackerId}
  offerUrl={quiz.offerUrl}
>
  <div class="min-h-screen bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-2xl mx-auto px-4 py-8 sm:py-12">
      <h1 class="text-2xl sm:text-3xl font-bold text-center text-text mb-2">{quiz.title}</h1>
      {quiz.description && (
        <p class="text-text-muted text-center mb-8">{quiz.description}</p>
      )}

      <div id="quiz-container">
        <!-- Progress bar -->
        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-8">
          <div id="progress-bar" class="bg-primary h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <p id="progress-text" class="text-sm text-text-muted text-right -mt-6 mb-6">1 / {quiz.steps.length}</p>

        <!-- Steps -->
        {quiz.steps.map((step, i) => (
          <div class="quiz-step hidden" data-step={i}>
            <h2 class="text-xl font-semibold mb-6 text-center">{step.question}</h2>
            <div class="grid gap-3">
              {step.answers?.map((answer) => (
                <button
                  class="quiz-answer w-full text-left px-6 py-4 bg-white border-2 border-gray-200 rounded-xl hover:border-primary hover:bg-blue-50 transition-all duration-200 text-base font-medium"
                  data-step={i}
                >
                  {answer.icon && <span class="mr-2">{answer.icon}</span>}
                  {answer.text}
                </button>
              ))}
            </div>
          </div>
        ))}

        <!-- Result -->
        <div id="quiz-result" class="hidden text-center">
          <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold mb-4">{quiz.result.title}</h2>
            <p class="text-text-muted mb-6 leading-relaxed">{quiz.result.text}</p>
            {quiz.result.image && (
              <img src={quiz.result.image} alt={quiz.result.title} class="rounded-xl mx-auto mb-6 max-w-xs" />
            )}
            <a
              href="#"
              data-offer-link
              class="inline-block px-8 py-4 bg-secondary hover:bg-secondary-dark text-white font-bold rounded-xl shadow-lg transition-all duration-200 hover:scale-105 text-lg"
            >
              {quiz.result.ctaText}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ totalSteps: quiz.steps.length }}>
    let current = 0;

    function showStep(n) {
      document.querySelectorAll('.quiz-step').forEach((el) => el.classList.add('hidden'));
      const step = document.querySelector(`[data-step="${n}"].quiz-step`);
      if (step) step.classList.remove('hidden');

      const pct = Math.round(((n + 1) / totalSteps) * 100);
      const bar = document.getElementById('progress-bar');
      const txt = document.getElementById('progress-text');
      if (bar) bar.style.width = pct + '%';
      if (txt) txt.textContent = (n + 1) + ' / ' + totalSteps;
    }

    document.querySelectorAll('.quiz-answer').forEach((btn) => {
      btn.addEventListener('click', function () {
        this.classList.add('border-primary', 'bg-blue-50');
        setTimeout(() => {
          current++;
          if (current >= totalSteps) {
            document.getElementById('quiz-container')
              ?.querySelectorAll('.quiz-step, [id=progress-bar], [id=progress-text]')
              .forEach((el) => el.classList.add('hidden'));
            const bar = document.querySelector('.bg-gray-200');
            if (bar) bar.classList.add('hidden');
            document.getElementById('quiz-result')?.classList.remove('hidden');
          } else {
            showStep(current);
          }
        }, 300);
      });
    });

    showStep(0);
  </script>
</BaseLayout>
