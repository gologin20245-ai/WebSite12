---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StarRating from '../../components/common/StarRating.astro';
import CtaButton from '../../components/common/CtaButton.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((r) => ({
    params: { slug: r.data.slug },
    props: { review: r },
  }));
}

const { review } = Astro.props;
const { data } = review;
const { Content } = await render(review);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'Product', name: data.productName, image: data.productImage },
  reviewRating: { '@type': 'Rating', ratingValue: data.rating, bestRating: 5 },
  author: { '@type': 'Person', name: data.author || 'Редакция' },
  datePublished: data.date,
  reviewBody: data.verdict,
};
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description || data.verdict}
  ogImage={data.productImage}
  lang={data.lang}
  noindex={data.noindex}
  jsonLd={jsonLd}
  trackerId={data.trackerId}
  offerUrl={data.offerUrl}
>
  <article class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
    <!-- Header card -->
    <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 mb-8 border border-gray-100">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        {data.productImage && (
          <img src={data.productImage} alt={data.productName} class="w-32 h-32 object-contain" />
        )}
        <div class="text-center sm:text-left">
          <h1 class="text-2xl sm:text-3xl font-bold mb-2">{data.productName}</h1>
          <StarRating rating={data.rating} />
          {data.price && (
            <p class="text-2xl font-bold text-primary mt-2">{data.price}</p>
          )}
        </div>
      </div>
    </div>

    <!-- Pros & Cons -->
    {(data.pros || data.cons) && (
      <div class="grid sm:grid-cols-2 gap-4 mb-8">
        {data.pros && data.pros.length > 0 && (
          <div class="bg-green-50 rounded-xl p-6">
            <h3 class="font-bold text-secondary mb-3">Достоинства</h3>
            <ul class="space-y-2">
              {data.pros.map((pro) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-secondary font-bold mt-0.5">+</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {data.cons && data.cons.length > 0 && (
          <div class="bg-red-50 rounded-xl p-6">
            <h3 class="font-bold text-danger mb-3">Недостатки</h3>
            <ul class="space-y-2">
              {data.cons.map((con) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-danger font-bold mt-0.5">−</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Review content -->
    <div class="prose prose-lg max-w-none mb-8
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:leading-relaxed [&_p]:mb-4
      [&_ul]:mb-4 [&_ul]:pl-6 [&_ul]:list-disc
      [&_ol]:mb-4 [&_ol]:pl-6 [&_ol]:list-decimal
      [&_li]:mb-2
      [&_table]:w-full [&_table]:border-collapse [&_table]:my-6
      [&_th]:bg-gray-50 [&_th]:px-4 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:border [&_th]:border-gray-200
      [&_td]:px-4 [&_td]:py-2 [&_td]:border [&_td]:border-gray-200
    ">
      <Content />
    </div>

    <!-- Verdict -->
    {data.verdict && (
      <div class="bg-blue-50 rounded-xl p-6 mb-8 border-l-4 border-primary">
        <h3 class="font-bold text-lg mb-2">Вердикт</h3>
        <p class="text-text">{data.verdict}</p>
      </div>
    )}

    <!-- CTA -->
    <div class="bg-gradient-to-r from-blue-50 to-green-50 rounded-2xl p-8 text-center border border-gray-100">
      <h3 class="text-xl font-bold mb-3">{data.productName}</h3>
      <div class="flex justify-center mb-4">
        <StarRating rating={data.rating} />
      </div>
      {data.price && <p class="text-2xl font-bold text-primary mb-4">{data.price}</p>}
      <CtaButton text={data.ctaText} />
    </div>
  </article>
</BaseLayout>
