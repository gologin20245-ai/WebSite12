---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaButton from '../../components/common/CtaButton.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((s) => ({
    params: { slug: s.data.slug },
    props: { story: s },
  }));
}

const { story } = Astro.props;
const { data } = story;
const { Content } = await render(story);
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description}
  lang={data.lang}
  noindex={data.noindex}
  trackerId={data.trackerId}
  offerUrl={data.offerUrl}
>
  <article class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
    <!-- Hero card -->
    <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 mb-8 border border-gray-100">
      <div class="flex items-center gap-4 mb-4">
        {data.heroAvatar && (
          <img src={data.heroAvatar} alt={data.heroName} class="w-16 h-16 rounded-full object-cover" />
        )}
        <div>
          <h2 class="text-xl font-bold">{data.heroName}{data.heroAge ? `, ${data.heroAge} лет` : ''}</h2>
          {data.heroLocation && (
            <p class="text-text-muted text-sm">{data.heroLocation}</p>
          )}
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold leading-tight">{data.title}</h1>
      {data.date && <p class="text-text-muted text-sm mt-2">{data.date}</p>}
    </div>

    <!-- Before / After -->
    {(data.beforeImage || data.afterImage) && (
      <div class="grid grid-cols-2 gap-4 mb-8">
        {data.beforeImage && (
          <div class="text-center">
            <img src={data.beforeImage} alt="До" class="rounded-xl w-full object-cover aspect-[3/4]" />
            <p class="font-semibold mt-2 text-text-muted">До</p>
          </div>
        )}
        {data.afterImage && (
          <div class="text-center">
            <img src={data.afterImage} alt="После" class="rounded-xl w-full object-cover aspect-[3/4]" />
            <p class="font-semibold mt-2 text-secondary">После</p>
          </div>
        )}
      </div>
    )}

    <!-- Story content -->
    <div class="prose prose-lg max-w-none mb-8
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:leading-relaxed [&_p]:mb-4
      [&_ul]:mb-4 [&_ul]:pl-6 [&_ul]:list-disc
      [&_ol]:mb-4 [&_ol]:pl-6 [&_ol]:list-decimal
      [&_li]:mb-2
    ">
      <Content />
    </div>

    <!-- Disclaimer -->
    <div class="bg-amber-50 rounded-xl p-4 mb-8 border border-amber-200">
      <p class="text-sm text-amber-800 italic">{data.disclaimer}</p>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-r from-blue-50 to-green-50 rounded-2xl p-8 text-center border border-gray-100">
      <h3 class="text-xl font-bold mb-3">Хотите такой же результат?</h3>
      <p class="text-text-muted mb-6">Узнайте больше о комплексе, который помог {data.heroName}</p>
      <CtaButton text={data.ctaText} />
    </div>
  </article>
</BaseLayout>
